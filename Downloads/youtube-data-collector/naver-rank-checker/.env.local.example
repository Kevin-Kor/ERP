# ==============================================
# YouTube Data Collector - Environment Variables
# ==============================================

# YouTube Data API v3 Configuration
# Get your API key from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# ==============================================
# Naver Cafe API (OAuth 2.0)
# ==============================================

# 네이버 개발자 센터에서 애플리케이션 등록 후 발급
# https://developers.naver.com/apps/
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_REDIRECT_URI=http://localhost:3000/api/naver/auth/callback

# ==============================================
# OpenAI API (콘텐츠 생성)
# ==============================================

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key

# ==============================================
# Token Encryption (보안)
# ==============================================

# 32바이트 hex 문자열 (64자)
# 생성: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_64_char_hex_string_here

# ==============================================
# Deployment Settings (Vercel/Production)
# ==============================================

NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your_random_secret_here

# ==============================================
# Optional: API Rate Limiting & Security
# ==============================================

API_RATE_LIMIT=60
NODE_ENV=development
