# Database (Supabase는 DATABASE_URL에 pooler(6543), DIRECT_URL에 직접 연결(5432)을 쓴다)
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"
DIRECT_URL="postgresql://user:password@localhost:5432/erp_db"

# NextAuth (운영에서는 반드시 강한 임의 값: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed accounts (npm run db:seed). 코드에 기본 비밀번호가 없으므로 직접 지정해야 한다 (10자 이상)
SEED_ADMIN_EMAIL="admin@agency.com"
SEED_ADMIN_PASSWORD=""
# 비워 두면 팀원 계정은 만들지 않는다
SEED_MEMBER_EMAIL="member@agency.com"
SEED_MEMBER_PASSWORD=""

# Supabase Storage (문서 첨부파일, 버킷 이름: erp-files). 서비스 롤 키는 서버에서만 사용
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Slack Integration (/api/slack/webhook 는 SLACK_SIGNING_SECRET 서명으로만 검증된다)
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_CHANNEL_ID="C0123456789"
SLACK_SIGNING_SECRET="your-slack-signing-secret"

# OpenAI (for AI parsing)
OPENAI_API_KEY="sk-your-openai-api-key"

# Google Calendar Integration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Cron Job Authentication (/api/cron/* 는 Authorization: Bearer $CRON_SECRET 으로만 검증된다)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# Default user email for Slack webhook actions
DEFAULT_USER_EMAIL="admin@agency.com"
